# Copia este archivo a .env para desarrollo local.
# En Vercel, crea las variables en Project → Settings → Environment Variables
# y vuelve a desplegar. Sin las VITE_ la app sigue en modo local (localStorage).
#
# SUPABASE_SERVICE_ROLE_KEY solo vive en el servidor (Vercel y este .env).
# No le pongas prefijo VITE_: si lo haces, el navegador la descarga.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
